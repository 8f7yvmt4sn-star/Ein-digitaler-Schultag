    let currentStation = 0;

    const scores = {
      organisation: 0,
      ressourcen: 0,
      didaktik: 0,
      analyse: 0,
      teilhabe: 0,
      datenschutz: 0,
      zusammenarbeit: 0,
      reflexion: 0
    };

    const scoreLabels = {
      organisation: "Organisation und professionelles Handeln",
      ressourcen: "Umgang mit digitalen Ressourcen",
      didaktik: "Didaktische Passung",
      analyse: "Analyse von Lernergebnissen",
      teilhabe: "Teilhabe und Differenzierung",
      datenschutz: "Datenschutz und verantwortungsvolle Nutzung",
      zusammenarbeit: "Zusammenarbeit und Kommunikation",
      reflexion: "Reflexion und Weiterentwicklung"
    };

    function renderStation() {
      const station = stations[currentStation];
      const stationElement = document.getElementById("station");

      document.getElementById("progressText").textContent =
        `Station ${currentStation + 1} von ${stations.length}`;

      document.getElementById("progressBar").style.width =
        `${(currentStation / stations.length) * 100}%`;

      stationElement.innerHTML = `
        <div class="meta">
          <span class="badge time">${station.time}</span>
          <span class="badge">Mathematik · Klasse 3</span>
        </div>

        <h2>${station.title}</h2>

        <div class="scenario">
          ${station.text}
        </div>

        <h3>Wie entscheidet sich Herr Weber?</h3>

        <div class="choices">
          ${station.choices.map((choice, index) => `
            <button onclick="choose(${index})">
              <span class="choice-number">${index + 1}</span>
              ${choice.text}
            </button>
          `).join("")}
        </div>

        <div id="feedback" class="feedback"></div>
      `;
    }

    function choose(choiceIndex) {
      const station = stations[currentStation];
      const choice = station.choices[choiceIndex];

      Object.entries(choice.score).forEach(([category, value]) => {
        scores[category] += value;
      });

      const feedback = document.getElementById("feedback");
      feedback.innerHTML = `
        <strong>Rückmeldung:</strong>
        <p>${choice.feedback}</p>
        <p class="small-note">
          Es gibt nicht immer nur eine richtige Lösung. Entscheidend ist,
          dass Herr Weber seine Entscheidung begründen und ihre Folgen einschätzen kann.
        </p>
        <button class="next-button" onclick="nextStation()">
          ${currentStation === stations.length - 1 ? "Zum Feierabend" : "Nächste Station"}
        </button>
      `;

      feedback.classList.add("visible");

      document.querySelectorAll(".choices button").forEach(button => {
        button.disabled = true;
        button.style.opacity = ".65";
        button.style.cursor = "default";
      });
    }

    function nextStation() {
      currentStation++;

      if (currentStation >= stations.length) {
        showFinal();
      } else {
        renderStation();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }

    function showFinal() {
      document.getElementById("game").style.display = "none";
      document.getElementById("final").classList.add("visible");
      document.getElementById("progressBar").style.width = "100%";

      const maxScore = 9;
      const rows = Object.entries(scoreLabels).map(([category, label]) => {
        const percentage = Math.min(
          100,
          Math.round((scores[category] / maxScore) * 100)
        );

        return `
          <div class="score-row">
            <strong>${label}</strong>
            <div class="score-track">
              <div class="score-fill" style="width: ${percentage}%"></div>
            </div>
            <strong>${percentage}%</strong>
          </div>
        `;
      }).join("");

      document.getElementById("scoreRows").innerHTML = rows;
      document.getElementById("scoreboard").classList.add("visible");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function restartGame() {
      currentStation = 0;

      Object.keys(scores).forEach(category => {
        scores[category] = 0;
      });

      document.getElementById("final").classList.remove("visible");
      document.getElementById("game").style.display = "block";

      renderStation();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    renderStation();
  </script>
</body>
</html>
