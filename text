        `,
        choices: [
          {
            text: "Du versuchst, die Stunde unverändert durchzuführen.",
            feedback: "Der Plan bleibt bestehen, aber die technische Störung erzeugt Stress und kostet Unterrichtszeit.",
            score: { organisation: 0, didaktik: 1 }
          },
          {
